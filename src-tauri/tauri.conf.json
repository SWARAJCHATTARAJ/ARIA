{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../frontend/dist",
    "withGlobalTauri": false
  },
  "package": {
    "name": "ARIA Science Engine",
    "version": "1.0.0",
    "description": "Autonomous Research & Intelligence Synthesis Engine",
    "identifier": "com.aria.app"
  },
  "tauri": {
    "allowlist": {
      "all": false
    },
    "bundle": {
      "active": true,
      "targets": [
        "nsis"
      ],
      "icon": [
        "icons/icon.png",
        "icons/icon.ico",
        "icons/icon.icns"
      ],
      "resources": [],
      "identifier": "tech.swarajchattaraj.aria"
    },
    "windows": [
      {
        "title": "ARIA Science Engine",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "visible": true,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#050811"
      }
    ]
  }
}
