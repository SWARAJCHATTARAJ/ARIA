{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARIA Science Engine",
  "version": "1.0.0",
  "identifier": "tech.swarajchattaraj.aria",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ARIA Science Engine",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "visible": true,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#050811"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": []
  }
}
