data: {"event": "audit", "answer_final": "- High‑fidelity engineered Cas9 nucleases such as SpCas9‑HF1, eSpCas9, and HypaCas9 contain mutated contact residues that destabilize non‑target strand binding, reducing off‑target cleavage [[c:0]].\n\n- Paired nickase configurations using the Cas9n D10A mutant create adjacent single‑strand breaks on opposite DNA strands, requiring two guide RNAs and thereby increasing specificity [[c:0]].\n\n- Prime‑editing systems and delivery of Cas9 as ribonucleoprotein (RNP) complexes provide transient nuclease activity, limiting off‑target accumulation [[c:0]].", "claims": [{"claim_id": 0, "text": "High‑fidelity engineered Cas9 nucleases such as SpCas9‑HF1, eSpCas9, and HypaCas9 contain mutated contact residues that destabilize non‑target strand binding, reducing off‑target cleavage.", "citation_ids": [0], "evidence": "High-fidelity engineered Cas9 nucleases (such as SpCas9-HF1, eSpCas9, and HypaCas9) featuring mutated contact residues that destabilize non-target strand binding.", "note": "Fully supported: Verified by verbatim evidence quote and entity check.", "supported": true, "status": "supported", "coverage": 0.842, "start": 0, "end": 198}, {"claim_id": 1, "text": "Paired nickase configurations using the Cas9n D10A mutant create adjacent single‑strand breaks on opposite DNA strands, requiring two guide RNAs and thereby increasing specificity.", "citation_ids": [0], "evidence": "Paired nickase configurations (Cas9n D10A) creating adjacent single-strand breaks on opposing strands, requiring dual guide RNA recognition.", "note": "Audit flagged: insufficient quote coverage (56.2% < 60%).", "supported": false, "status": "partially_supported", "coverage": 0.562, "start": 200, "end": 390}, {"claim_id": 2, "text": "Prime‑editing systems and delivery of Cas9 as ribonucleoprotein (RNP) complexes provide transient nuclease activity, limiting off‑target accumulation.", "citation_ids": [0], "evidence": "Prime editing systems and transient delivery via ribonucleoprotein (RNP) complexes, restricting nuclease exposure duration to diminish off-target accumulation.", "note": "Fully supported: Verified by verbatim evidence quote and entity check.", "supported": true, "status": "supported", "coverage": 0.727, "start": 392, "end": 552}], "removed_claims": [], "conflicts": [], "retractions": [], "confidence": 0.7, "tier_agreement": null, "repaired": true, "sources": [{"source": "ARIA Molecular Biology Synthesis", "source_type": "pgvector", "tier": "RAG", "similarity": 0.8404, "is_retracted": false, "rank": null, "published": null, "cited": true}]}

