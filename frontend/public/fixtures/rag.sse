data: {"event": "citation", "id": 0, "title": "CRISPR Cas9 off-target mitigation", "path": "okf/crispr_cas9_mechanisms.md", "url": null, "authors": null, "year": 2026, "venue": "ARIA Molecular Biology Synthesis", "snippet": "Off-target cleavage during CRISPR-Cas9 genome editing presents substantial challenges for therapeutic translation. Key mitigation strategies include:\n1. High-fidelity engineered Cas9 nucleases (such as SpCas9-HF1, eSpCas9, and HypaCas9) featuring mutated contact residues that destabilize non-target strand binding.\n2. Paired nickase configurations (Cas9n D10A) creating adjacent single-strand breaks on opposing strands, requiring dual guide RNA recognition.\n3. Prime editing systems and transient delivery via ribonucleoprotein (RNP) complexes, restricting nuclease exposure duration to diminish off-target accumulation.\n\nReferences:\n1. Kleinstiver, B. P., et al. (2016). \"High-fidelity CRISPR–Cas9 nucleases with no detectable genome-wide off-target effects\", Nature, 529(7587), 490-495. [verified]\n2. Ran, F. A., et al. (2013). \"Double nicking by RNA-guided CRISPR Cas9 for enhanced genome editing specificity\", Cell, 154(6), 1380-1389. [verified]\n3. Anzalone, A. V., et al. (2019). \"Search-and-replace genome editing without double-strand breaks or donor DNA\", Nature, 576(7785), 149-157. [verified]", "source_type": "pgvector", "tier": "RAG", "doi": null, "arxiv_id": null, "is_retracted": false, "review_status": "verified", "cited": false, "rank": null, "published": null}

