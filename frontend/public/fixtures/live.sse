data: {"event": "retrieve", "tiers": ["LIVE"], "okf_node_paths": [], "rag_scores": [], "sources": [{"source": "https://doi.org/10.1117/1.jatis.10.1.011208", "source_type": "openalex", "tier": "LIVE", "similarity": null, "is_retracted": false, "rank": 1, "published": "2024-02-05", "cited": false}, {"source": "https://doi.org/10.3847/1538-3881/ad890d", "source_type": "openalex", "tier": "LIVE", "similarity": null, "is_retracted": false, "rank": 2, "published": "2024-12-10", "cited": false}, {"source": "https://blog.jameswebbdiscovery.com/2024/03/james-webb-space-telescope-discoveries.html", "source_type": "duckduckgo", "tier": "LIVE", "similarity": null, "is_retracted": false, "rank": 3, "published": "2024", "cited": false}, {"source": "https://doi.org/10.33140/ssj.01.02.10", "source_type": "openalex", "tier": "LIVE", "similarity": null, "is_retracted": false, "rank": 4, "published": "2024-08-02", "cited": false}, {"source": "https://blog.jaseph.com/top-5-james-webb-telescope-discoveries-in-2024/8934/", "source_type": "duckduckgo", "tier": "LIVE", "similarity": null, "is_retracted": false, "rank": 5, "published": "2024", "cited": false}]}

data: {"event": "citation", "id": 0, "title": "Lessons learned from systems engineering on the James Webb Space Telescope", "path": null, "url": "https://doi.org/10.1117/1.jatis.10.1.011208", "authors": ["Michael Menzel", "Keith Parrish", "Lee D. Feinberg", "Paul H. Geithner", "Julie Van Campen", "Michael W. McElwain", "Sandra Irish"], "year": 2024, "venue": "Journal of Astronomical Telescopes Instruments and Systems", "snippet": "The James Webb Space Telescope is NASA’s flagship mission and successor to the highly successful Hubble Space Telescope. It is an infrared observatory featuring a cryogenic 6.6 m aperture, deployable optical telescope element with a payload of four science instruments assembled into an integrated science instrument module that provide imagery and spectroscopy in the near infrared band between 0.6 and 5 μm and in the mid-infrared band between 5 and 28 μm. JWST was successfully launched on December 25, 2021, aboard an Ariane 5 launch vehicle. All 50 major deployments were successfully completed by January 8, 2022. The observatory performed all mid-course correction maneuvers and achieved its operational mission orbit around the Sun-Earth second Lagrange Point. All commissioning and calibration activities have been completed and JWST has begun its science mission. Its present performance meets or out-performs all requirements. Launching over 20 years after its mission concept review, the JWST", "source_type": "openalex", "tier": "LIVE", "doi": "10.1117/1.jatis.10.1.011208", "arxiv_id": null, "is_retracted": false, "review_status": "scholarly", "cited": false, "rank": 1, "published": "2024-02-05"}

data: {"event": "citation", "id": 1, "title": "Searching for Planets Orbiting Vega with the James Webb Space Telescope", "path": null, "url": "https://doi.org/10.3847/1538-3881/ad890d", "authors": ["Charles Beichman", "G. Bryden", "Jorge D. Llop-Sayson", "Marie Ygouf", "Alexandra Z. Greenbaum", "Jarron Leisenring", "Andras Gáspár", "John Krist", "George H. Rieke", "Schuyler Grace Wolff", "Kate Y. L. Su", "K. W. Hodapp", "Michael R. Meyer", "Doug Kelly", "Martha L. Boyer", "Doug Johnstone", "Scott Horner", "Marcia J. Rieke"], "year": 2024, "venue": "The Astronomical Journal", "snippet": "Abstract The most prominent of the IRAS debris disk systems, α Lyrae (Vega), at a distance of 7.7 pc, has been observed by both the NIRCam and MIRI instruments on the James Webb Space Telescope. This paper describes NIRCam coronagraphic observations, which have achieved F444W contrast levels of 3 × 10−7 at 1″ (7.7 au), 1 × 10−7 at 2″ (15 au), and a few × 10−8 beyond 5″ (38 au), corresponding to masses of <3, 2, and 0.5 M J for a system age of 700 Myr. Two F444W objects are identified in the outer MIRI debris disk, around 48 au. One of these is detected by MIRI and appears to be extended with a spectral energy distribution similar to those of distant extragalactic sources. The second one also appears extended in the NIRCam data suggestive of an extragalactic nature. The NIRCam limits within the inner disk (1″–10″) correspond", "source_type": "openalex", "tier": "LIVE", "doi": "10.3847/1538-3881/ad890d", "arxiv_id": null, "is_retracted": false, "review_status": "scholarly", "cited": false, "rank": 2, "published": "2024-12-10"}

data: {"event": "citation", "id": 2, "title": "James Webb Space Telescope Discoveries Tracker", "path": null, "url": "https://blog.jameswebbdiscovery.com/2024/03/james-webb-space-telescope-discoveries.html", "authors": null, "year": 2024, "venue": "DuckDuckGo", "snippet": "Mar 19, 2024 · James Webb Telescope Unlocks the Universe's Secrets: March 2024 Discoveries The James Webb Space Telescope (JWST), humanity's most powerful observatory, continues to revolutionize our understanding of the cosmos.", "source_type": "duckduckgo", "tier": "LIVE", "doi": null, "arxiv_id": null, "is_retracted": false, "review_status": "unreviewed_web", "cited": false, "rank": 3, "published": "2024"}

data: {"event": "citation", "id": 3, "title": "The James Webb Space Telescope (JWST) Anomalies Resolved", "path": null, "url": "https://doi.org/10.33140/ssj.01.02.10", "authors": ["James R. Arnold"], "year": 2024, "venue": "Space science journal.", "snippet": "A model of the universe is offered that can derive the Hubble Constant independent of empirical measurement, using just a midline estimate of the age of the universe and simple arithmetic calculations. It can explain the JWST discoveries of apparent anomalous early galaxy formations without need of substantial revisions to established astrophysical theories, as the new findings have seemed to require. Concepts of “Dark energy”, cosmic flatness, cosmic inflation, and an accelerating expansion of the universe are rendered unnecessary or at least partly misinterpreted.", "source_type": "openalex", "tier": "LIVE", "doi": "10.33140/ssj.01.02.10", "arxiv_id": null, "is_retracted": false, "review_status": "scholarly", "cited": false, "rank": 4, "published": "2024-08-02"}

data: {"event": "citation", "id": 4, "title": "Top 5 James Webb Telescope Discoveries in 2024: Exoplanets ...", "path": null, "url": "https://blog.jaseph.com/top-5-james-webb-telescope-discoveries-in-2024/8934/", "authors": null, "year": 2024, "venue": "DuckDuckGo", "snippet": "Sep 27, 2024 · The top James Webb Space Telescope discoveries of 2024, including exoplanet breakthroughs, deep space images, and insights into star formation. Learn how JWST is transforming our understanding of the universe.", "source_type": "duckduckgo", "tier": "LIVE", "doi": null, "arxiv_id": null, "is_retracted": false, "review_status": "unreviewed_web", "cited": false, "rank": 5, "published": "2024"}

