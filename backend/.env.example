# ==============================================================================
# ARIA v2 Backend Environment Configuration
# ==============================================================================

# Groq API Configuration (Fast Inference & Verification)
GROQ_API_KEY=your_groq_api_key_here
GROQ_WRITER_MODEL=openai/gpt-oss-120b
GROQ_JUDGE_MODEL=openai/gpt-oss-120b
GROQ_WRITER_TPM=7500
GROQ_WRITER_TPD=160000
GROQ_JUDGE_TPM=7500
GROQ_JUDGE_TPD=160000
DAILY_TOKEN_CAP=160000

# Supabase (Database, Auth & Vector Search)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
JWT_AUTH_ENABLED=false

# Cache & External Services
REDIS_URL=redis://localhost:6379/0
# DRISTI_URL=http://localhost:8001  # Optional / Disconnected: ARIA v2 operates 100% standalone

# Server & Network Security
ARIA_PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,https://aria.swarajchattaraj.tech
FETCH_TOP_N=2
