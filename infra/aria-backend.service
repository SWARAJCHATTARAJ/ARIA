[Unit]
Description=ARIA v2 FastAPI Backend
After=network.target

[Service]
User=aria
Group=www-data
WorkingDirectory=/opt/aria/backend
Environment="PATH=/opt/aria/venv/bin"
EnvironmentFile=/opt/aria/backend/.env
ExecStart=/opt/aria/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 4

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
